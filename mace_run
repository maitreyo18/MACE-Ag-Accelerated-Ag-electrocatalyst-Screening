"""
Predict spontaneous polarisation P_s of ferroelectrics with MACE-Field-MP-0,
using pymatgen's same-branch algorithm for the (un)folding.

Model:    MACE-field-mp-0b3-medium.model
          -> release asset v1.0.1 of github.com/mdi-group/mace-field
             https://github.com/mdi-group/mace-field/releases/tag/1.0.1
          (use the v1.0.1-tagged code or current main; the older v1.0 models
           use ScaleShiftFieldMACE and will NOT load on current code.)

Dataset:  Ferroelectrics_mp_structs_id2.pkl  (non-polar -> polar distortion paths)

Idea:
  - MACE-Field gives the TOTAL Cartesian polarisation density P (e/Ang^2) at E=0.
  - pymatgen.Polarization wants dipole moments (e*Ang), nonpolar->polar.
    Convert with p = P * Omega  (Omega = cell volume in Ang^3).
  - Put the total dipole in p_elecs, zeros in p_ions, p_elecs_in_cartesian=True.
  - pymatgen runs the same-branch nearest-image walk and returns P_s in uC/cm^2.
"""

import pickle
import numpy as np
from ase import Atoms
from mace.calculators import MACECalculator
from pymatgen.core import Structure
from pymatgen.io.ase import AseAtomsAdaptor
from pymatgen.analysis.ferroelectricity.polarization import Polarization

# --------------------------------------------------------------------------- #
# Config
# --------------------------------------------------------------------------- #
MODEL_PATH = "MACE-field-mp-0b3-medium.model"
DATASET_PATH = "Ferroelectrics_mp_structs_id2.pkl"
DEVICE = "cuda"                      # or "cpu"
E_FIELD = [0.0, 0.0, 0.0]            # V/Ang -- zero field for spontaneous P_s


# --------------------------------------------------------------------------- #
# 1. Field-aware calculator
# --------------------------------------------------------------------------- #
calc = MACECalculator(
    model_path=MODEL_PATH,
    model_type="MACEField",
    electric_field=E_FIELD,          # global field; overrides per-structure field
    device=DEVICE,
    default_dtype="float64",         # float64 strongly advised for response props
)


def mace_polarization_eA2(structure: Structure) -> np.ndarray:
    """Total Cartesian polarisation density P (e/Ang^2) for one frame at E=0.

    Evaluated on the REAL geometry/cell of the frame -- the polar-volume choice
    below is only about how P is normalised into a dipole, not what MACE sees.
    """
    atoms = AseAtomsAdaptor.get_atoms(structure)
    atoms.calc = calc
    atoms.get_potential_energy()                                  # triggers autograd
    return np.asarray(atoms.calc.results["polarization"], float).reshape(3)  # e/Ang^2


# --------------------------------------------------------------------------- #
# 2. Spontaneous polarisation via pymatgen same-branch unfolding
# --------------------------------------------------------------------------- #
def spontaneous_polarization(path_structures):
    """
    path_structures: list[pymatgen.Structure], ordered NON-POLAR (0) -> POLAR (last),
    fixed-cell linear interpolation as in MP-Ferroelectric.

    A single volume/lattice -- that of the POLAR endpoint -- is used everywhere:
    for the P -> dipole conversion, for pymatgen's volume normalisation, and for
    the polarisation quantum. For a genuinely fixed-cell path this is exact; if
    cells vary slightly it pins one consistent quantum so the branch walk and the
    dipole/volume round-trip stay unit-consistent (p/Omega recovers P exactly).

    Returns:
        same_branch : list of per-frame same-branch P (uC/cm^2)
        dP_vec      : spontaneous polarisation vector P_s (uC/cm^2)
        dP_norm     : |P_s| (uC/cm^2)
    """
    polar = path_structures[-1]
    Omega = polar.volume        # Ang^3   -- single volume everywhere
    lattice = polar.lattice     #          -- single lattice (sets the quantum)

    # P (e/Ang^2) from the real geometry -> dipole (e*Ang) using the POLAR volume.
    P_cart = np.array([mace_polarization_eA2(s) for s in path_structures])  # [N,3]
    p_elecs = P_cart * Omega                                                # e*Ang
    p_ions = np.zeros_like(p_elecs)        # total P already lives in p_elecs

    # Re-cast every frame onto the polar cell (keep fractional coords) so that
    # pymatgen's internal volume and lattice quantum are the polar ones too.
    pmg_structs = [
        Structure(lattice, s.species, s.frac_coords, coords_are_cartesian=False)
        for s in path_structures
    ]

    polarization = Polarization(
        p_elecs,
        p_ions,
        pmg_structs,
        p_elecs_in_cartesian=True,   # MACE-Field P is a Cartesian vector
        p_ions_in_cartesian=True,    # zeros -> flag irrelevant, kept consistent
    )

    same_branch = polarization.get_same_branch_polarization_data(
        convert_to_muC_per_cm2=True, all_in_polar=True               # proper polarisation
    )
    dP_vec = np.ravel(polarization.get_polarization_change(
        convert_to_muC_per_cm2=True, all_in_polar=True))
    dP_norm = float(polarization.get_polarization_change_norm(
        convert_to_muC_per_cm2=True, all_in_polar=True))

    return same_branch, dP_vec, dP_norm


# --------------------------------------------------------------------------- #
# 3. Dataset adapter (Smidt-style MP-Ferroelectric DataFrame) + loop
# --------------------------------------------------------------------------- #
# Each row holds two ENDPOINT structures (nonpolar + polar), not a path. We must
# rebuild the fixed-cell distortion path ourselves before the branch walk.
#
# Column names vary between dumps -- set these to whatever your DataFrame uses.
COL_ID = "id"
COL_REF_PS = "polarization.norm"               # DFT reference |Ps| (uC/cm^2), for checking
COL_NONPOLAR = "nonpolar_structure"            # try also: "structure_nonpolar"
COL_POLAR = "polar_structure"                  # try also: "structure_polar"
N_IMAGES = 9                                    # 9 -> 10 frames incl. both endpoints
AUTOSORT_TOL = 0.5                              # Ang; reorders sites to match endpoints


def as_structure(obj) -> Structure:
    """Deserialize a stored structure: pymatgen Structure, dict, JSON str, or ASE."""
    if isinstance(obj, Structure):
        return obj
    if isinstance(obj, Atoms):
        return AseAtomsAdaptor.get_structure(obj)
    if isinstance(obj, dict):
        return Structure.from_dict(obj)
    if isinstance(obj, str):
        return Structure.from_str(obj, fmt="json")
    raise TypeError(f"Cannot interpret structure of type {type(obj)}")


def _pick(row, *candidates):
    """Return the first present, non-null column value among candidates."""
    for c in candidates:
        if c in row and row[c] is not None:
            return row[c]
    raise KeyError(f"None of {candidates} found in row columns: {list(row.index)}")


def build_path(nonpolar: Structure, polar: Structure):
    """
    Fixed-cell distortion path (10 frames) nonpolar -> polar, all in the POLAR cell.

    The nonpolar endpoint is recast into the polar lattice (same fractional coords)
    so the whole path shares one cell/quantum, matching how MP-Ferroelectric defines
    the distortion. autosort_tol lets pymatgen fix minor site-order mismatches; if
    the endpoints are not actually matched this will still produce a jagged path.
    """
    if len(nonpolar) != len(polar):
        raise ValueError(f"Endpoint atom counts differ: {len(nonpolar)} vs {len(polar)}")
    nonpolar_in_polar = Structure(
        polar.lattice, nonpolar.species, nonpolar.frac_coords, coords_are_cartesian=False
    )
    # interpolate() returns N_IMAGES+1 structures including both endpoints, polar cell.
    return nonpolar_in_polar.interpolate(
        polar, nimages=N_IMAGES, interpolate_lattices=False, autosort_tol=AUTOSORT_TOL
    )


def main():
    import pandas as pd

    df = pd.read_pickle(DATASET_PATH)          # Smidt-style DataFrame
    print(f"Loaded {len(df)} materials. Columns: {list(df.columns)}\n")

    rows = []
    for _, row in df.iterrows():
        mp_id = row[COL_ID] if COL_ID in row else _
        try:
            nonpolar = as_structure(_pick(row, COL_NONPOLAR, "structure_nonpolar"))
            polar = as_structure(_pick(row, COL_POLAR, "structure_polar"))
            path = build_path(nonpolar, polar)                 # nonpolar -> polar

            _, Ps_vec, Ps_pred = spontaneous_polarization(path)

            Ps_ref = float(row[COL_REF_PS]) if COL_REF_PS in row else np.nan
            err = abs(Ps_pred - Ps_ref) if np.isfinite(Ps_ref) else np.nan
            rows.append({"id": mp_id, "Ps_pred": Ps_pred, "Ps_ref": Ps_ref,
                         "abs_err": err})
            print(f"{str(mp_id):>14}  |Ps|_pred = {Ps_pred:7.2f}   "
                  f"|Ps|_ref = {Ps_ref:7.2f}   |err| = {err:6.2f} uC/cm^2")
        except Exception as exc:
            print(f"{str(mp_id):>14}  SKIPPED ({exc})")

    out = pd.DataFrame(rows)
    if not out.empty and out["abs_err"].notna().any():
        mae = out["abs_err"].mean(skipna=True)
        print(f"\nMAE vs reference |Ps|: {mae:.2f} uC/cm^2 over {out['abs_err'].notna().sum()} materials")
    return out


if __name__ == "__main__":
    main()
